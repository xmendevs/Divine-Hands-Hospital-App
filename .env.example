# Development baseline — copy to .env and fill in real values.
# Never commit real secrets. Values here are examples only.

# Logging / time
LOG_LEVEL=info
APP_TIMEZONE=UTC

# PostgreSQL
DATABASE_URL=postgres://hims:change-me@127.0.0.1:5432/hims?sslmode=disable
POSTGRES_USER=hims
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hims
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Sessions & MFA
SESSION_TTL=8h
PASSWORD_RESET_TTL=1h
MFA_ISSUER=Divine Hands HMS
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Super admin seed (used by `go run ./cmd/seed`)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_EMPLOYEE_NO=EMP-0001

# S3-compatible object storage (dev: MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hims-backups
S3_REGION=us-east-1
