# Development baseline — copy to .env and fill in real values.
# Never commit real secrets. Values here are examples only.

# Logging / time
LOG_LEVEL=info
APP_TIMEZONE=UTC

# PostgreSQL
POSTGRES_USER=hims
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hims
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# S3-compatible object storage (dev: MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hims-backups
S3_REGION=us-east-1
