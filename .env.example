# Development baseline — copy to .env and fill in real values.
# Never commit real secrets. Values here are examples only.

# Logging / time
LOG_LEVEL=info
APP_TIMEZONE=UTC

# HTTP listen address. Default 127.0.0.1 is local-only. On the main/server PC
# set HOST=0.0.0.0 so the other PCs can reach it over the LAN.
# HOST=0.0.0.0
# PORT=8080

# PostgreSQL
DATABASE_URL=postgres://hims:change-me@127.0.0.1:5432/hims?sslmode=disable
POSTGRES_USER=hims
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hims
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis (not used by the core service; only a readiness check).
# Set REDIS_ENABLED=false for single-box/LAN deployments that don't run Redis.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Sessions & MFA
SESSION_TTL=8h
PASSWORD_RESET_TTL=1h
MFA_ISSUER=Divine Hands HMS
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Super admin seed (used by `go run ./cmd/seed`)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_EMPLOYEE_NO=EMP-0001

# Dev object storage (MinIO — used by infra/docker/docker-compose.yml only)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=hims-backups
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Backup & cloud backup (Phase 13).
#
# Production backups are AES-256-GCM encrypted BEFORE they touch disk. For the
# 3-PC hospital, point BACKUP_LOCAL_DIR at a Google Drive synced folder: the
# Drive desktop app uploads the encrypted files whenever internet is available.
# Full runbook: docs/backup-google-drive.md
# ---------------------------------------------------------------------------
BACKUP_ENABLED=false

# 32-byte hex key. Generate with:  openssl rand -hex 32
# Store this OUTSIDE the synced folder — never inside Google Drive.
BACKUP_ENCRYPTION_KEY=

# Google Drive example (Windows): C:\Users\<you>\Google Drive\hims-backups
BACKUP_LOCAL_DIR=./backups

# PostgreSQL client binary (ships with PostgreSQL)
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_MIGRATIONS_DIR=db/migrations
# Comma-separated config files to encrypt alongside the database dump
BACKUP_CONFIG_FILES=

# Retention tiers (daily / weekly / monthly)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Scheduler intervals
BACKUP_LOCAL_INTERVAL=24h
BACKUP_CLOUD_INTERVAL=24h
BACKUP_VERIFY_INTERVAL=24h

# Optional S3-compatible object storage (Backblaze B2 / Cloudflare R2) in
# addition to the local folder. Leave empty to use Google Drive only.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PATH_STYLE=false
