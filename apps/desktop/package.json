{
  "name": "@hims/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Divine Hands Hospital desktop client (Tauri + Electron packaging)",
  "author": "Divine Hands Hospital",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --win nsis",
    "dist:server": "pnpm build && node scripts/build-server-payload.mjs && electron-builder --win nsis --config electron-builder.server.yml",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb",
    "dist:server:linux": "pnpm build && TARGET_OS=linux node scripts/build-server-payload.mjs && electron-builder --linux AppImage deb --config electron-builder.server.yml"
  },
  "dependencies": {
    "@hims/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.4",
    "vitest": "^3.1.0"
  },  "build": {
    "appId": "com.divinehands.hospital",
    "productName": "Divine Hands Hospital",
    "executableName": "divine-hands-hospital",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Medical",
      "maintainer": "Divine Hands Hospital <chuks4brown@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Divine Hands Hospital"
    }
  }
}
